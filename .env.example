# Copy this file to .env and fill in keys for the providers you plan to use.

# OpenAI — GPT models (also used as the LLM judge for static grading)
OPENAI_API_KEY=

# Anthropic — Claude models
ANTHROPIC_API_KEY=

# Google — Gemini models (GEMINI_API_KEY or GOOGLE_API_KEY both work)
GOOGLE_API_KEY=

# OpenRouter — routes the remaining models (Grok, DeepSeek, Qwen, Mistral, Llama)
OPENROUTER_API_KEY=

# Optional: custom OpenAI-compatible endpoints
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# Optional: route generation through a LiteLLM proxy (used with --use-litellm)
# LITELLM_API_KEY=
# LITELLM_BASE_URL=
